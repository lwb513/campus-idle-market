# PostgreSQL connection. Replace every placeholder with your local settings.
DATABASE_URL=postgresql+psycopg://postgres:your_postgresql_password@127.0.0.1:5432/campus_market

# Optional OpenAI-compatible model configuration. If omitted, the project uses
# conservative local fallback templates so the feature remains demoable.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Backward-compatible common default. You may leave this empty when using the
# two dedicated model settings below.
OPENAI_MODEL=
# Used only when a new category needs a reusable label template.
TEMPLATE_OPENAI_MODEL=
# Used for buyer category identification and query_plan extraction.
MATCH_OPENAI_MODEL=

# Set to true only after OPENAI_API_KEY and OPENAI_MODEL are configured.
ENABLE_LLM_GENERATION=false
# LLM requests used by matching and first-time template generation are bounded.
MATCH_LLM_TIMEOUT_SECONDS=5
TEMPLATE_LLM_TIMEOUT_SECONDS=45

# Replace this before deploying. It signs login tokens.
JWT_SECRET_KEY=replace-with-a-long-random-string
JWT_EXPIRE_MINUTES=10080

# MinIO object storage. Start MinIO before uploading item images.
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=campus-market
MINIO_SECURE=true
